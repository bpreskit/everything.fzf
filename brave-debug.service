[Unit]
Description=Brave Browser Remote Debugging Service
Documentation=man:brave-browser(1)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=forking
Environment=DISPLAY=:0

# Use the script we created to manage the Brave debugging setup
ExecStart=%h/source_code/everything.fzf/start-brave-debug.sh start
ExecStop=%h/source_code/everything.fzf/start-brave-debug.sh stop
ExecReload=%h/source_code/everything.fzf/start-brave-debug.sh restart

# Process management
PIDFile=%t/brave/brave.pid
RemainAfterExit=yes
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=15

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Security and resource limits
PrivateNetwork=false
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=%t/brave %T %h/.config %h/.cache
NoNewPrivileges=false
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brave-debug

[Install]
WantedBy=default.target
