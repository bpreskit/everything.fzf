require 'bundler/inline'
require 'rbconfig'
require 'tempfile'
require 'json'
require 'shellwords'
require 'socket'

gemfile do
  source 'https://rubygems.org'
  gem 'sqlite3'
  gem 'ansi256'
end

# Brave fzf integration
module BraveFzf
  extend self

  # Platform-specific constants.
  # FIXME: Commands for Linux and Windows are not tested.
  BASE_PATH, OPEN_COMMAND, CLIP_COMMAND, FOCUS_COMMAND =
    case RbConfig::CONFIG['host_os']
    when /darwin/
      ['Library/Application Support/Google/Brave', 'open {+2}', 'echo -n {+2} | pbcopy', DATA.read]
    when /linux/
      ['.config/BraveSoftware/Brave-Browser', 'xdg-open {+2}', 'echo -n {+2} | xsel --clipboard --input', '']
    else
      ['AppData\Local\Google\Brave\User Data', 'start {+2}', 'echo {+2} | clip', '']
    end

  DELIMITER = "\a"
  RS = "\x0"

  def run(type)
    IO.popen(fzf(type), 'r+') do |io|
      list(type, io)
    end
  rescue Errno::EPIPE
    # Ignore broken pipe error
  end

  def list(type, io = $stdout)
    method(type).call.each do |args|
      format(io, *args)
    end
  end

  private

  def path(name) = File.join(Dir.home, BASE_PATH, 'Default', name)

  # Build fzf command
  def fzf(name)
    <<~CMD
      fzf --ansi --read0 #{'--multi' unless name == :tabs} --info inline-right --reverse --scheme history \\
          --header-border --gap \\
          --highlight-line --height 100% --wrap --wrap-sign ' ↳ ' \\
          --border --border-label " Brave::#{name.capitalize} " --delimiter "#{DELIMITER}" \\
          --header '╱ CTRL-T: Tabs ╱ CTRL-H: History ╱ CTRL-B: Bookmarks || CTRL-Y: Copy to clipboard ╱ CTRL-W: Close tabs ╱' \\
          --with-shell 'bash -c' \\
          --with-nth "{1}\n · {2}" \\
          --bind 'enter:execute-silent(
                    if [[ {3} ]]; then
                      printf "{\\"id\\": %d, \\"method\\": \\"Target.activateTarget\\", \\"params\\": {\\"targetId\\": \\"%s\\"}}\\0" $RANDOM {3} | socat -t 0.2 - UNIX-CONNECT:/run/user/$UID/brave/brave.sock > /dev/null
                      #{FOCUS_COMMAND}
                    else
                      #{OPEN_COMMAND}
                    fi)+deselect-all' \\
          --bind 'ctrl-y:execute-silent(#{CLIP_COMMAND})+bell+deselect-all' \\
          --bind 'ctrl-b:reload(ruby #{__FILE__.shellescape} --list b)+change-multi+change-border-label( Brave::Bookmarks )+top' \\
          --bind 'ctrl-t:reload(ruby #{__FILE__.shellescape} --list t)+change-multi(0)+change-border-label( Brave::Tabs )+top' \\
          --bind 'ctrl-h:reload(ruby #{__FILE__.shellescape} --list h)+change-multi+change-border-label( Brave::History )+top' \\
          --bind 'ctrl-w:transform:
                  [[ $FZF_BORDER_LABEL =~ Tabs ]] || exit
                  printf "{\\"id\\": %d, \\"method\\": \\"Target.closeTarget\\", \\"params\\": {\\"targetId\\": \\"%s\\"}}\\0" $RANDOM {3} | socat -t 0.2 - UNIX-CONNECT:/run/user/$UID/brave/brave.sock > /dev/null
                  echo "reload:ruby #{__FILE__.shellescape} --list t"
          '
    CMD
  end

  def format(io, title, url, time, id = nil)
    time = Time.at(time).strftime('%F %T') if time.is_a?(Integer)
    io.print "#{title} (#{time.yellow})".strip
    io.print DELIMITER
    io.print url.blue.dim
    if id
      io.print DELIMITER
      io.print id
    end
    io.print RS
  end

  def history
    Tempfile.create('brave') do |temp|
      temp.close
      FileUtils.cp(path('History'), temp.path)
      SQLite3::Database.open(temp.path) do |db|
        rows = db.execute('select title, url, last_visit_time from urls order by last_visit_time desc')
        rows.map do |title, url, time|
          [title, url, to_unix(time)]
        end
      end
    end
  end

  def bookmarks
    build = lambda do |parent, json|
      name = [parent, json[:name]].compact.join('/')
      if json[:type] == 'folder'
        json[:children].flat_map { |child| build[name, child] }
      else
        [[name, json[:url], to_unix(json.values_at(:date_last_used, :date_added).max)]]
      end
    end

    JSON.load_file(path('Bookmarks'), symbolize_names: true)
        .fetch(:roots, {})
        .values
        .flat_map { |e| build[nil, e] }
        .sort_by(&:last)
        .reverse
  end

  def tabs
    # Get list of tabs from Brave DevTools Protocol via Unix socket using shell command
    socket_path = "/run/user/#{Process.uid}/brave/brave.sock"

    unless File.exist?(socket_path)
      $stderr.puts "Error: Brave socket not found at #{socket_path}"
      return []
    end

    begin
      # Send request and handle potentially multiple buffered responses
      request_id = rand(1000000)
      response_json = `printf '{"id": %d, "method": "Target.getTargets"}\\0' #{request_id} | socat -t 0.2 - UNIX-CONNECT:#{socket_path.shellescape}`.strip

      # Handle multiple responses separated by null bytes - find the one matching our request ID
      responses = response_json.split("\0").reject(&:empty?)

      return [] if responses.empty?

      # Try to find a response that matches our request ID, or use the last valid one
      target_response = nil
      responses.each do |resp_json|
        begin
          parsed = JSON.parse(resp_json)
          if parsed['id'] == request_id || parsed['result']&.key?('targetInfos')
            target_response = parsed
            break
          end
        rescue JSON::ParserError
          next
        end
      end

      # If no matching response found, try the last response
      target_response ||= begin
        JSON.parse(responses.last)
      rescue JSON::ParserError => e
        $stderr.puts "Error parsing JSON: #{e.message}"
        $stderr.puts "Raw responses: #{responses.inspect}"
        return []
      end

      unless target_response && target_response['result']
        $stderr.puts "Invalid response structure: #{target_response.inspect}"
        return []
      end

      targets = target_response['result']['targetInfos'] || []

      # Filter for page targets only, then map with proper indexing
      page_targets = targets.select { |target| target['type'] == 'page' }

      page_targets.map.with_index do |target, idx|
        title = target['title'] || 'Untitled'
        url = target['url'] || ''
        target_id = target['targetId']
        # Use current timestamp since we don't have tab creation time
        timestamp = Time.now.to_i

        [title, url, timestamp, target_id]
      end
    rescue => e
      $stderr.puts "Error getting tabs: #{e.message}"
      []
    end
  end

  def to_unix(time)
    time.to_i / 1_000_000 - 11_644_473_600
  end

  # Helper method for Brave DevTools Protocol via Unix socket
  def brave_socket_request(method, params = {})
    socket_path = "/run/user/#{Process.uid}/brave/brave.sock"

    unless File.exist?(socket_path)
      $stderr.puts "Error: Brave socket not found at #{socket_path}"
      $stderr.puts "Make sure Brave is running with debugging enabled"
      return nil
    end

    request = {
      id: rand(1000000),
      method: method,
      params: params
    }

    begin
      socket = UNIXSocket.new(socket_path)
      socket.write(request.to_json + "\0")

      # Read until we get a complete JSON response
      response_data = ""
      loop do
        chunk = socket.read_nonblock(1024)
        response_data += chunk

        # Check if we have a complete response (ends with null byte)
        if response_data.include?("\0")
          break
        end
      rescue IO::WaitReadable
        # Wait for data to be available
        IO.select([socket])
        retry
      rescue EOFError
        break
      end

      socket.close

      # Remove null terminator and parse JSON
      response_json = response_data.chomp("\0")
      return nil if response_json.empty?

      JSON.parse(response_json)
    rescue => e
      $stderr.puts "Error communicating with Brave: #{e.message}"
      $stderr.puts "Response data: #{response_data.inspect}" if defined?(response_data)
      nil
    end
  end

  # Helper method for Brave DevTools Protocol API calls
  def devtools_request(endpoint, method = 'GET')
    uri = URI("http://localhost:9229/json/#{endpoint}")
    http = Net::HTTP.new(uri.host, uri.port)
    http.read_timeout = 5

    request = case method.upcase
              when 'GET' then Net::HTTP::Get.new(uri)
              when 'POST' then Net::HTTP::Post.new(uri)
              else raise "Unsupported method: #{method}"
              end

    response = http.request(request)
    response.is_a?(Net::HTTPSuccess) ? response.body : nil
  rescue => e
    $stderr.puts "DevTools API error: #{e.message}"
    nil
  end
end

method = ARGV.delete('--list') ? :list : :run
type = case ARGV[0]&.downcase
       when 'h', nil then :history
       when 'b' then :bookmarks
       when 't' then :tabs
       else abort "Usage: #{__FILE__} [t|h|b]"
       end

BraveFzf.send(method, type)

__END__
osascript << EOF
tell application "System Events"
  tell process "Brave"
    set frontmost to true
  end tell
end tell
EOF
