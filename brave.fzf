require 'bundler/inline'
require 'rbconfig'
require 'tempfile'
require 'json'
require 'shellwords'
require 'net/http'
require 'uri'

gemfile do
  source 'https://rubygems.org'
  gem 'sqlite3'
  gem 'ansi256'
end

# Brave fzf integration
module BraveFzf
  extend self

  # Platform-specific constants.
  # FIXME: Commands for Linux and Windows are not tested.
  BASE_PATH, OPEN_COMMAND, CLIP_COMMAND, FOCUS_COMMAND =
    case RbConfig::CONFIG['host_os']
    when /darwin/
      ['Library/Application Support/Google/Brave', 'open {+2}', 'echo -n {+2} | pbcopy', DATA.read]
    when /linux/
      ['.config/BraveSoftware/Brave-Browser', 'xdg-open {+2}', 'echo -n {+2} | xsel --clipboard --input', '']
    else
      ['AppData\Local\Google\Brave\User Data', 'start {+2}', 'echo {+2} | clip', '']
    end

  DELIMITER = "\a"
  RS = "\x0"

  def run(type)
    IO.popen(fzf(type), 'r+') do |io|
      list(type, io)
    end
  rescue Errno::EPIPE
    # Ignore broken pipe error
  end

  def list(type, io = $stdout)
    method(type).call.each do |args|
      format(io, *args)
    end
  end

  private

  def path(name) = File.join(Dir.home, BASE_PATH, 'Default', name)

  # Build fzf command
  def fzf(name)
    <<~CMD
      fzf --ansi --read0 #{'--multi' unless name == :tabs} --info inline-right --reverse --scheme history \\
          --header-border --gap \\
          --highlight-line --height 100% --wrap --wrap-sign ' ↳ ' \\
          --border --border-label " Brave::#{name.capitalize} " --delimiter "#{DELIMITER}" \\
          --header '╱ CTRL-T: Tabs ╱ CTRL-H: History ╱ CTRL-B: Bookmarks || CTRL-Y: Copy to clipboard ╱ CTRL-W: Close tabs ╱' \\
          --with-shell 'bash -c' \\
          --with-nth "{1}\n · {2}" \\
          --bind 'enter:execute-silent(
                    if [[ {3} ]]; then
                      curl -s -X POST http://localhost:9229/json/activate/{3} > /dev/null
                      #{FOCUS_COMMAND}
                    else
                      #{OPEN_COMMAND}
                    fi)+deselect-all' \\
          --bind 'ctrl-y:execute-silent(#{CLIP_COMMAND})+bell+deselect-all' \\
          --bind 'ctrl-b:reload(ruby #{__FILE__.shellescape} --list b)+change-multi+change-border-label( Brave::Bookmarks )+top' \\
          --bind 'ctrl-t:reload(ruby #{__FILE__.shellescape} --list t)+change-multi(0)+change-border-label( Brave::Tabs )+top' \\
          --bind 'ctrl-h:reload(ruby #{__FILE__.shellescape} --list h)+change-multi+change-border-label( Brave::History )+top' \\
          --bind 'ctrl-w:transform:
                  [[ $FZF_BORDER_LABEL =~ Tabs ]] || exit
                  curl -s -X POST http://localhost:9229/json/close/{3} > /dev/null
                  echo "reload:ruby #{__FILE__.shellescape} --list t"
          '
    CMD
  end

  def format(io, title, url, time, id = nil)
    time = Time.at(time).strftime('%F %T') if time.is_a?(Integer)
    io.print "#{title} (#{time.yellow})".strip
    io.print DELIMITER
    io.print url.blue.dim
    if id
      io.print DELIMITER
      io.print id
    end
    io.print RS
  end

  def history
    Tempfile.create('brave') do |temp|
      temp.close
      FileUtils.cp(path('History'), temp.path)
      SQLite3::Database.open(temp.path) do |db|
        rows = db.execute('select title, url, last_visit_time from urls order by last_visit_time desc')
        rows.map do |title, url, time|
          [title, url, to_unix(time)]
        end
      end
    end
  end

  def bookmarks
    build = lambda do |parent, json|
      name = [parent, json[:name]].compact.join('/')
      if json[:type] == 'folder'
        json[:children].flat_map { |child| build[name, child] }
      else
        [[name, json[:url], to_unix(json.values_at(:date_last_used, :date_added).max)]]
      end
    end

    JSON.load_file(path('Bookmarks'), symbolize_names: true)
        .fetch(:roots, {})
        .values
        .flat_map { |e| build[nil, e] }
        .sort_by(&:last)
        .reverse
  end

  def tabs
    begin
      # Get list of tabs from Brave DevTools Protocol
      uri = URI('http://localhost:9229/json')
      response = Net::HTTP.get_response(uri)

      unless response.is_a?(Net::HTTPSuccess)
        $stderr.puts "Error: Could not connect to Brave debugger on localhost:9229"
        $stderr.puts "Make sure Brave is running with --remote-debugging-port=9229"
        return []
      end

      tabs_data = JSON.parse(response.body)

      # Filter for pages only, then map with proper indexing
      page_tabs = tabs_data.select { |tab| tab['type'] == 'page' }

      page_tabs.map.with_index do |tab, idx|
        title = tab['title'] || 'Untitled'
        url = tab['url'] || ''
        tab_id = tab['id']
        # Use current timestamp since we don't have tab creation time
        timestamp = Time.now.to_i

        [title, url, timestamp, tab_id]
      end
    rescue => e
      $stderr.puts "Error connecting to Brave debugger: #{e.message}"
      $stderr.puts "Make sure Brave is running with --remote-debugging-port=9229"
      []
    end
  end

  def to_unix(time)
    time.to_i / 1_000_000 - 11_644_473_600
  end

  # Helper method for Brave DevTools Protocol API calls
  def devtools_request(endpoint, method = 'GET')
    uri = URI("http://localhost:9229/json/#{endpoint}")
    http = Net::HTTP.new(uri.host, uri.port)
    http.read_timeout = 5

    request = case method.upcase
              when 'GET' then Net::HTTP::Get.new(uri)
              when 'POST' then Net::HTTP::Post.new(uri)
              else raise "Unsupported method: #{method}"
              end

    response = http.request(request)
    response.is_a?(Net::HTTPSuccess) ? response.body : nil
  rescue => e
    $stderr.puts "DevTools API error: #{e.message}"
    nil
  end
end

method = ARGV.delete('--list') ? :list : :run
type = case ARGV[0]&.downcase
       when 'h' then :history
       when 'b' then :bookmarks
       when 't', nil then :tabs
       else abort "Usage: #{__FILE__} [t|h|b]"
       end

BraveFzf.send(method, type)

__END__
osascript << EOF
tell application "System Events"
  tell process "Brave"
    set frontmost to true
  end tell
end tell
EOF
